<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape>
            <solid android:color="#DDE5D8" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/kanto_primary" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#DDE5D8" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#C5CEC0" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>

</selector>