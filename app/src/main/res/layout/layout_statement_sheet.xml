<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:padding="16dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvStatementName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Neighbor Name"
                    android:textColor="@color/kanto_text_head"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Statement"
                    android:textColor="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseStatement"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="#F1F5F9"
                android:src="@drawable/ic_add"
                android:rotation="45"
                app:tint="#64748B" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:paddingHorizontal="24dp"
            android:fadeScrollbars="false"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvStatementHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/kanto_text_head"
                android:textSize="14sp"
                android:lineSpacingExtra="6dp"
                android:text="History will load here..."/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FINAL OUTSTANDING BALANCE"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/tvStatementBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textColor="#C62828"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnSettleStatement"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_rounded_button"
                android:text="Settle Account"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/kanto_primary"
                app:icon="@drawable/ic_receipt"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>