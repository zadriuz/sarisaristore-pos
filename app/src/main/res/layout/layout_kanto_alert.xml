<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp"
    android:background="@drawable/bg_card_rounded"
    android:backgroundTint="#FFFFFF"
    android:elevation="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgAlertIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_white"
        android:backgroundTint="#D1FAE5"
        android:padding="16dp"
        android:src="@drawable/ic_warning"
        app:tint="#DC2626" />

    <TextView
        android:id="@+id/tvAlertTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Alert Title"
        android:textAlignment="center"
        android:textColor="@color/kanto_text_head"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAlertMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:lineSpacingExtra="4dp"
        android:text="Alert Message Details"
        android:textAlignment="center"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnAlertRight"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_rounded_button"
            android:text="Add to Inventory"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/kanto_primary" />

        <Button
            android:id="@+id/btnAlertLeft"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_rounded_button"
            android:text="Cancel"
            android:textColor="@color/kanto_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#E8F0E3" />
    </LinearLayout>
</LinearLayout>