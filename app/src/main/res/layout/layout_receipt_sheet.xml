<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:padding="16dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:paddingTop="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvReceiptTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Receipt Details"
                android:textColor="@color/kanto_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseReceipt"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="#F1F5F9"
                android:src="@drawable/ic_add"
                android:rotation="45"
                app:tint="#64748B" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvReceiptDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:text="Oct 24, 2026 • 2:45 PM"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:paddingHorizontal="24dp"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/tvReceiptItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/kanto_text_head"
                android:textSize="16sp"
                android:lineSpacingExtra="16dp"
                android:text="Items will load here..."/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="65dp"
                android:background="@drawable/bg_rounded_button"
                android:backgroundTint="#E8F0E3"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvReceiptTotalLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total"
                    android:textColor="@color/kanto_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReceiptTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱0.00"
                    android:textColor="@color/kanto_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnVoidTransaction"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:text="Void Transaction"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_rounded_button"
                app:backgroundTint="@color/kanto_primary"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>