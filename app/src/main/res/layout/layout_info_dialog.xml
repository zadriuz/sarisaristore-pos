<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="340dp"
    android:background="@drawable/bg_card_rounded"
    android:backgroundTint="#FFFFFF"
    android:elevation="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_white"
        android:backgroundTint="#A7F3D0"
        android:padding="16dp"
        android:src="@drawable/ic_info"
        app:tint="@color/kanto_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="About This Page"
        android:textAlignment="center"
        android:textColor="@color/kanto_text_head"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInfoMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:lineSpacingExtra="4dp"
        android:text="This is the dashboard where you process transactions."
        android:textAlignment="center"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnInfoGotIt"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_dialog_btn_solid"
        android:text="Got it!"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>