<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#CBD5E1"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Charge to Utang"
        android:textAlignment="center"
        android:textColor="@color/kanto_text_head"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <AutoCompleteTextView
        android:id="@+id/etUtangNameInput"
        android:drawableStart="@drawable/ic_people"
        android:drawablePadding="12dp"
        android:textColorHint="#64748B"

        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_rounded_input"
        android:backgroundTint="#F1F5F9"
        android:hint="Type or select neighbor's name..."
        android:paddingHorizontal="16dp"
        android:completionThreshold="1"
        android:textColor="@color/kanto_text_head"
        android:textSize="16sp"
        android:inputType="textCapWords"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnConfirmUtangCheckout"
        app:icon="@drawable/ic_check"
        app:iconGravity="textEnd"
        app:iconTint="@color/white"

        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_rounded_button"
        android:text="Verify &amp; Checkout"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/kanto_primary" />

</LinearLayout>