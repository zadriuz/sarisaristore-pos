<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/kanto_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ate Edna's Mini Store"
            android:textColor="@color/kanto_text_head"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_card"
            android:padding="24dp"
            android:elevation="3dp"
            android:layout_marginHorizontal="8dp">

            <EditText
                android:textCursorDrawable="@null"
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_input"
                android:drawableStart="@drawable/ic_user"
                android:drawablePadding="12dp"
                android:hint="Username"
                android:inputType="textNoSuggestions"
                android:textColor="@color/kanto_text_body"
                android:textColorHint="@color/kanto_neutral"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:textCursorDrawable="@null"
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:maxLength="12"
                android:textColor="@color/kanto_text_body"
                android:textColorHint="@color/kanto_neutral"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnLogin"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_button"
                android:text="Login"
                app:backgroundTint="@color/kanto_primary"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconTint="@color/white"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/kanto_neutral"
                    android:alpha="0.3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OR"
                    android:textColor="@color/kanto_neutral"
                    android:textSize="12sp"
                    android:layout_marginHorizontal="12dp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/kanto_neutral"
                    android:alpha="0.3"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnBiometric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_button"
                android:text="Admin Biometric Login"
                android:textColor="@color/kanto_primary"
                app:backgroundTint="@color/kanto_card"
                app:icon="@drawable/ic_fingerprint"
                app:iconGravity="textStart"
                app:iconTint="@color/kanto_primary" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>