<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_checkout_pod"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D1D1D1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Store Menu"
        android:textAlignment="center"
        android:textColor="@color/kanto_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnMenuHistory"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_rounded_button"
        android:text="Transaction History"
        app:iconTint="@color/kanto_primary"
        app:icon="@drawable/ic_receipt"
        app:iconGravity="textStart"
        android:textColor="@color/kanto_text_head"
        app:backgroundTint="#E8F0E3" />

    <Button
        android:id="@+id/btnMenuUtang"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_rounded_button"
        android:text="Manage Debts"
        app:iconTint="@color/kanto_primary"
        app:icon="@drawable/ic_debt"
        app:iconGravity="textStart"
        android:textColor="@color/kanto_text_head"
        app:backgroundTint="#E8F0E3" />

    <Button
        android:id="@+id/btnMenuInventory"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_rounded_button"
        android:text="Manage Inventory"
        app:iconTint="@color/kanto_primary"
        app:icon="@drawable/ic_inventory"
        app:iconGravity="textStart"
        android:textColor="@color/kanto_text_head"
        app:backgroundTint="#E8F0E3" />

    <Button
        android:id="@+id/btnMenuGcash"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_rounded_button"
        android:text="GCash Services"
        app:iconTint="@color/white"
        app:icon="@drawable/ic_gcash"
        app:iconGravity="textStart"
        android:textColor="@color/white"
        app:backgroundTint="#007bff" />

    <Button
        android:id="@+id/btnMenuAdmin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_rounded_button"
        android:text="Admin Dashboard"
        app:iconTint="@color/white"
        app:icon="@drawable/ic_dashboard"
        app:iconGravity="textStart"
        android:textColor="@color/white"
        app:backgroundTint="@color/kanto_primary" />

    <Button
        android:id="@+id/btnMenuCheckout"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_rounded_button"
        android:text="POS / Checkout"
        app:iconTint="@color/kanto_primary"
        app:icon="@drawable/ic_pos"
        app:iconGravity="textStart"
        android:textColor="@color/kanto_text_head"
        app:backgroundTint="#E8F0E3" />

</LinearLayout>